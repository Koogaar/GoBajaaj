<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep the session out of cloud backups so a reinstall starts logged out. -->
        <exclude domain="sharedpref" path="gobajaaj_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Do not carry a login across devices. -->
        <exclude domain="sharedpref" path="gobajaaj_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
