<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Never restore the session/prefs across installs or devices: a stale
         "gobajaaj_prefs" (user_id, role, auth token) is what caused the app to
         open on the Driver Pass screen and to attempt unauthenticated inserts. -->
    <exclude domain="sharedpref" path="gobajaaj_prefs.xml"/>
</full-backup-content>
